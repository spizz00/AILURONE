  presentationRoot: {fileID: 1363221655}
  presentationGroup: {fileID: 1363221657}
  subtitleText: {fileID: 742105531}
  readabilityGradient: {fileID: 472198243}
  subtitleBackdrop: {fileID: 333415764}
  charactersPerSecond: 55
  continuousTypingClip: {fileID: 8300000, guid: 747308a23c8cae04e8ae9d290e56c82a, type: 3}
  typewriterAudioSource: {fileID: 793963044}
  beatFadeInDuration: 0.18
  beatCrossfadeDuration: 0.12
  shotEndingFadeOutDuration: 0.18
  finalBeatMinimumVisibleTime: 0.35
  shots:
  - beats:
    - text: In 2069, sentient machines turned against their creators.
      automaticRevealTime: 1
    - text: Humanity's defenses collapsed. The war was already lost.
      automaticRevealTime: 6
    endingFadeTime: 11
  - beats:
    - text: Facing extinction, the surviving governments authorized one final experiment.
      automaticRevealTime: 1
    - text: PROJECT AILURONE was humanity's last attempt to change its fate.
      automaticRevealTime: 6
    endingFadeTime: 11
  - beats:
    - text: Humanity disappeared before the project could be completed.
      automaticRevealTime: 1
    - text: The facility fell silent. FEI-A29 was left behind.
      automaticRevealTime: 6
    endingFadeTime: 11
  - beats:
    - text: Centuries passed. Humanity became a memory.
      automaticRevealTime: 1
    - text: The machines reshaped the world in their own image.
      automaticRevealTime: 6
    endingFadeTime: 11
  - beats:
    - text: Then, after centuries of silence...
      automaticRevealTime: 1
    - text: one forgotten unit came back online.
      automaticRevealTime: 6
    endingFadeTime: 11
  - beats: []
    endingFadeTime: 6.6200004
